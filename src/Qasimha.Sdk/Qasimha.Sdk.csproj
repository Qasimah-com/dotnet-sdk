<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <RootNamespace>Qasimha.Sdk</RootNamespace>
    <AssemblyName>Qasimha.Sdk</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Qasimha.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Authors>Qasimha</Authors>
    <Company>Qasimha</Company>
    <Product>Qasimha Merchant SDK for .NET</Product>
    <Description>Server-side .NET SDK for the Qasimha merchant API: checkout sessions, orders, payment links and QR, settlements, and webhook signature verification.</Description>
    <PackageTags>qasimha;bnpl;payments;checkout;instalments;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) Qasimha</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Qasimha.Sdk.Tests" />
  </ItemGroup>

  <Target Name="GenerateSdkVersionSource" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <SdkVersionSourceFile>$(IntermediateOutputPath)SdkVersion.g.cs</SdkVersionSourceFile>
    </PropertyGroup>
    <ItemGroup>
      <SdkVersionSourceLine Include="namespace Qasimha.Sdk%3B" />
      <SdkVersionSourceLine Include=" " />
      <SdkVersionSourceLine Include="internal static class SdkVersion" />
      <SdkVersionSourceLine Include="{" />
      <SdkVersionSourceLine Include="    public const string Current = &quot;$(Version)&quot;%3B" />
      <SdkVersionSourceLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(SdkVersionSourceFile)" Lines="@(SdkVersionSourceLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(SdkVersionSourceFile)" />
      <FileWrites Include="$(SdkVersionSourceFile)" />
    </ItemGroup>
  </Target>

</Project>
